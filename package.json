{
  "name": "gmail-address-checker",
  "version": "0.0.5",
  "description": "Gmailで送信前に外部ドメインのメールアドレスをリアルタイムで警告表示する拡張機能",
  "main": "index.js",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "npm run typecheck && npm run test:run",
    "postinstall": "wxt prepare"
  },
  "keywords": [
    "gmail",
    "chrome-extension",
    "email",
    "security",
    "productivity"
  ],
  "author": "cti1650",
  "license": "MIT",
  "dependencies": {
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/storage": "^1.2.6",
    "tldts": "^7.0.30",
    "wxt": "^0.20.11"
  },
  "volta": {
    "node": "25.2.1",
    "npm": "11.6.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/ui": "^4.0.15",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
